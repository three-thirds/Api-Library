[
  {
    "id": "weather",
    "name": "Weather",
    "category": "Data",
    "route": "/api/v1/weather",
    "method": "GET",
    "description": "Current weather for a city",
    "auth": false,
    "params": [
      { "name": "latitude", "type": "string", "required": true, "example": "-33.9141", "description": "Latitude" },
      { "name": "longitude", "type": "string", "required": true, "example": "151.2152", "description": "Longitude" }
    ],
    "response": { "ok": true, "data": { "city": "Sydney", "tempC": 21.4 } },
    "errors": [
      { "code": "BAD_REQUEST", "status": 400, "message": "Missing latitude or longitude query parameters" },
      {"code": "INTERNAL_SERVER_ERROR", "status": 500, "message": "Internal server error" }
    ]
  }
]