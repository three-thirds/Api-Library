{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "threethirds",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-21",
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			"binding": "VAULT_KV",
			"id": "63f43be5479948edb78be22b1281a2a2"
		}
	],
	"d1_databases": [
		{
			"binding": "threethirds_db",
			"database_name": "threethirds-db",
			"database_id": "d6a38df3-fb81-423a-88bd-f06d0c01a290"
		}
	]
}